package main

import (
	"errors"
	"fmt"
	"os"
	"strconv"
	"strings"

	"gitlab.com/wkhere/goto/core"
)

type pargs struct {
	tags   []string
	cmd    func(*pargs)
	action action
	prep   bool
	dryrun bool

	help func()
}

type taskAction func(core.Task, core.Vars) (bool, string, []core.Handler, error)
type transferAction func(core.Transfer, core.Vars) (string, error)

type action interface{ isAction() }

func (taskAction) isAction()     {}
func (transferAction) isAction() {}

func usage() {
	fmt.Printf(`usage: %[1]s [-t,--tags=TAGS] [-r,--remote=HOST] VERB

	VERB: prep|transfer|view|exec

`,
		os.Args[0],
	)
}

func parseArgs(args []string) (a pargs, _ error) {

	var p = PState{Args: args}
	var verb string
	var remote string

	for ; len(p.Args) > 0 && p.Err == nil; p.Next() {
		switch {

		case p.MatchFlagExpr("-t", "--tags"):
			a.tags = strings.Split(p.Val, ",")

		case p.MatchFlagExpr("-r", "--remote"):
			remote = p.Val

		case p.MatchJustFlag("-h", "--help"):
			a.help = usage
			return a, nil

		case p.MatchAnyFlag():
			p.Errorf("invalid flag: %s", p.Flag)

		default:
			if verb != "" {
				p.Errorf("conflicting verbs: %s %s", verb, p.Arg())
			}
			switch verb = p.Arg(); verb {
			case "prep":
				a.cmd = transfer
				a.action = transferAction(core.Transfer.RemotePrep)
				a.prep = true

			case "transfer":
				a.cmd = transfer
				a.action = transferAction(core.Transfer.DoTransfer)

			case "view":
				a.cmd = run
				a.action = taskAction(core.Task.View)
				a.dryrun = true

			case "exec":
				a.cmd = run
				a.action = taskAction(core.Task.Exec)

			default:
				p.Errorf("unknown verb: %s", verb)
			}
		}
	}

	switch {
	case p.Err != nil:
		return a, p.Err

	case verb == "":
		return a, errors.New("no verb given")

	case verb == "transfer" && remote == "":
		return a, errors.New("-r,--remote needed for transfer")

	case verb == "transfer":
		Vars[core.MetavarRemote] = remote

	}
	return a, nil
}

func transfer(a *pargs) {
	f, ok := a.action.(transferAction)
	if !ok {
		die(1, errors.New("action mismatch"))
	}

	var transfers []core.Transfer

	for _, task := range Tasks(a.tags) {
		if tr, ok := task.(core.Transfer); ok {
			transfers = append(transfers, tr)
		}
	}

	if len(transfers) == 0 {
		return
	}

	if a.prep {
		fmt.Println("== transfer preps:")
	} else {
		fmt.Println("== transfers:")
	}
	for _, tr := range transfers {
		stats, err := f(tr, Vars)
		if err != nil {
			fmt.Printf("=== %s, error: %v\n\n", tr.Desc(), err)
			os.Exit(1)
		}
		fmt.Printf("=== %s, %s\n\n", tr.Desc(), stats)
	}
}

func run(a *pargs) {
	f, ok := a.action.(taskAction)
	if !ok {
		die(1, errors.New("action mismatch"))
	}

	tasks := Tasks(a.tags)
	if len(tasks) == 0 {
		fmt.Println("== no tasks for given tags")
		return
	}

	var handlers []core.Handler

	if a.dryrun {
		fmt.Println("== tasks dry-run:")
	} else {
		fmt.Println("== tasks:")
	}

	for _, task := range tasks {
		changed, diff, notify, err := f(task, Vars)
		if err != nil {
			fmt.Printf("=== %s, error: %v\n\n", task.Desc(), err)
			os.Exit(1)
		}
		fmt.Printf("=== %s, changed: %v\n", task.Desc(), changed)
		if changed {
			fmt.Println(diff)
		} else {
			fmt.Println()
		}
		handlers = append(handlers, notify...)
	}

	if len(handlers) == 0 {
		return
	}
	core.DedupHandlers(&handlers)

	fmt.Println("== handlers:")

	for _, handler := range handlers {

		if a.dryrun {
			fmt.Printf("=== %#v\n", handler)
			continue
		}

		err := handler.Run()
		if err != nil {
			fmt.Printf("=== %#v, error: %v\n", handler, err)
			os.Exit(1)
		}
		fmt.Printf("=== %#v OK\n", handler)
	}
}

func main() {
	a, err := parseArgs(os.Args[1:])
	if err != nil {
		die(2, err)
	}
	if a.help != nil {
		a.help()
		os.Exit(0)
	}

	a.cmd(&a)
}

func die(exitcode int, err error) {
	fmt.Fprintln(os.Stderr, os.Args[0]+":", err)
	os.Exit(exitcode)
}

type PState struct {
	Args      []string
	Err       error
	Flag, Val string
}

func (p *PState) Next() { p.Args = p.Args[1:] }

func (p *PState) Arg() string { return p.Args[0] }

func (p *PState) Error(err error) bool {
	// saving only the first error
	if p.Err == nil {
		p.Err = err
	}
	return false
}

func (p *PState) Errorf(format string, a ...any) bool {
	// saving only the first error
	if p.Err == nil {
		p.Err = fmt.Errorf(format, a...)
	}
	return false
}

func (p *PState) MatchJustFlag(short, long string) bool {
	p.Flag, p.Val = "", ""

	s := p.Args[0]
	if s == short || s == long {
		p.Flag = s
		return true
	}
	return false
}

func (p *PState) MatchJustSingleFlag(flag string) bool {
	p.Flag, p.Val = "", ""

	s := p.Args[0]
	if s == flag {
		p.Flag = s
		return true
	}
	return false
}

func (p *PState) MatchAnyFlag() bool {
	p.Flag, p.Val = "", ""

	s := p.Args[0]
	if len(s) > 1 && s[0] == '-' {
		p.Flag = s
		return true
	}
	return false
}

func (p *PState) MatchFlagExpr(short, long string) bool {
	p.Flag, p.Val = "", ""

	var s = p.Args[0]
	var n int
	var isLong bool

	if strings.HasPrefix(s, long) {
		n, isLong = len(long), true
	} else if strings.HasPrefix(s, short) {
		n = len(short)
	} else {
		return false
	}

	p.Flag, s = s[:n], s[n:]
	if isLong {
		if len(s) == 0 {
			if len(p.Args) == 1 {
				return p.Errorf("flag %s needs a value", p.Flag)
			}
			p.Val, p.Args = p.Args[1], p.Args[1:]
			return true
		}
		if s[0] != '=' {
			return false
		}
		s = s[1:]
	} else {
		if len(s) > 0 && s[0] == '=' {
			s = s[1:]
		}
	}

	if len(s) == 0 {
		if len(p.Args) == 1 {
			return p.Errorf("flag %s needs a value", p.Flag)
		}
		p.Val, p.Args = p.Args[1], p.Args[1:]
		return true
	}
	p.Val = s
	return true
}

func (p *PState) MatchLongFlagExpr(long string) bool {
	p.Flag, p.Val = "", ""

	var s = p.Args[0]
	var n int

	if strings.HasPrefix(s, long) {
		n = len(long)
	} else {
		return false
	}

	p.Flag, s = s[:n], s[n:]
	if len(s) == 0 {
		if len(p.Args) == 1 {
			return p.Errorf("flag %s needs a value", p.Flag)
		}
		p.Val, p.Args = p.Args[1], p.Args[1:]
		return true
	}
	if s[0] != '=' {
		return false
	}
	s = s[1:]

	if len(s) == 0 {
		if len(p.Args) == 1 {
			return p.Errorf("flag %s needs a value", p.Flag)
		}
		p.Val, p.Args = p.Args[1], p.Args[1:]
		return true
	}
	p.Val = s
	return true
}

func (p *PState) MatchBoolFlag(short, long string) bool {
	p.Flag, p.Val = "", ""

	var s = p.Args[0]
	var n int
	var isLong bool

	if strings.HasPrefix(s, long) {
		n, isLong = len(long), true
	} else if strings.HasPrefix(s, short) {
		n = len(short)
	} else {
		return false
	}

	p.Flag, s = s[:n], s[n:]
	switch {
	case len(s) == 0:
		s = "true"
	case isLong:
		if s[0] != '=' {
			return false
		}
		s = s[1:]
	case !isLong:
		if len(s) > 0 && s[0] == '=' {
			s = s[1:]
		}
	}
	p.Val = s
	return true
}

func (p *PState) ParseBool(dest *bool) bool {
	x, err := strconv.ParseBool(p.Val)
	if err != nil {
		return p.Errorf("flag %s: %w", p.Flag, err)
	}
	*dest = x
	return true
}

func (p *PState) ParseInt(dest *int) bool {
	x, err := strconv.Atoi(p.Val)
	if err != nil {
		return p.Errorf("flag %s: %w", p.Flag, err)
	}
	*dest = x
	return true
}

func (p *PState) ParseUint(dest *uint) bool {
	x, err := strconv.ParseUint(p.Val, 10, 0)
	if err != nil {
		return p.Errorf("flag %s: %w", p.Flag, err)
	}
	*dest = uint(x)
	return true
}

func (p *PState) ParseFloat(dest *float64) bool {
	x, err := strconv.ParseFloat(p.Val, 64)
	if err != nil {
		return p.Errorf("flag %s: %w", p.Flag, err)
	}
	*dest = x
	return true
}
